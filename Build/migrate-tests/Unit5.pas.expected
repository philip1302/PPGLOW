unit Unit5;

interface

uses
  Vcl.Forms, Vcl.Buttons, Vcl.ExtCtrls, Vcl.Menus, Vcl.StdCtrls,
  PPG.Panel, PPG.Edit, PPG.Button, PPG.Menus;

type
  TForm5 = class(TForm)
    Panel1: TPPGPanel;
    Edit1: TPPGEdit;
    OkBtn: TPPGButton;
    CancelBtn: TPPGButton;
    YesBtn: TPPGButton;
    NoBtn: TPPGButton;
    CloseBtn: TPPGButton;
    CustomBtn: TPPGButton;
    PopupMenu1: TPPGPopupMenu;
    Item1: TMenuItem;
    Item2: TMenuItem;
    procedure Item1Click(Sender: TObject);
  end;

implementation

{$R *.dfm}

procedure TForm5.Item1Click(Sender: TObject);
begin
  if Sender is TBitBtn then
    Caption := (Sender as TBitBtn).Caption;
  TBitBtn(Sender).Caption := 'x'; // TBitBtn( im Kommentar zaehlt nicht
  with OkBtn do
    Caption := 'y';
  with Panel1, CloseBtn do
    Visible := True;
end;

end.
