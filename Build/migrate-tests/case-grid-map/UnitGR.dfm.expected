object FormGR: TFormGR
  Left = 0
  Top = 0
  object Grid1: TMyGrid
    Left = 8
    Top = 8
    Options = [dgTitles, dgAlwaysShowEditor]
    OnCellClick = Grid1CellClick
    OnDrawColumnCell = Grid1DrawColumnCell
    OnTitleRightClick = Grid1TitleRightClick
    OnColumnResized = Grid1ColumnResized
    SortOnTitleClick = False
    Columns = <
      item
        FieldName = 'Name'
        Title = 'Name'
        TitleStyle.ParentFont = False
        TitleStyle.Font.Style = [fsBold]
        Width = 120
        Visible = True
      end>
  end
  object Grid2: TExternalGrid
    Left = 8
    Top = 200
    OnCellClick = Grid1CellClick
    Columns = <
      item
        FieldName = 'Nr'
        Title = 'Nr.'
        TitleAlignment = gtaRight
        Visible = True
      end>
  end
end
